{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"C:/Users/osama/SchoolApp/.claude/hooks/frontend-guard.js\"" },
          { "type": "command", "command": "node \"C:/Users/osama/SchoolApp/.claude/hooks/protect-deploy-ids.js\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"C:/Users/osama/SchoolApp/.claude/hooks/worker-check.js\"", "timeout": 90 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node --check:*)",
      "Bash(node worker/test-routes.js)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(npx wrangler deployments list:*)",
      "Bash(npx wrangler versions list:*)",
      "Bash(curl.exe -s -D - https://yemenschoolz.com/*)",
      "Bash(curl.exe -s -D - https://school.procorners.com/*)",
      "mcp__cloudflare-observability__observability_keys",
      "mcp__cloudflare-observability__observability_values",
      "mcp__cloudflare-observability__query_worker_observability",
      "mcp__cloudflare-observability__workers_get_worker",
      "mcp__cloudflare-observability__search_cloudflare_documentation"
    ]
  }
}
