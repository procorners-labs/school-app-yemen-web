{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"C:/Users/osama/SchoolApp/.claude/hooks/measure-guard.js\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"C:/Users/osama/SchoolApp/.claude/hooks/frontend-guard.js\"" },
          { "type": "command", "command": "node \"C:/Users/osama/SchoolApp/.claude/hooks/protect-deploy-ids.js\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"C:/Users/osama/SchoolApp/.claude/hooks/worker-check.js\"", "timeout": 90 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node --check:*)",
      "Bash(node worker/test-routes.js)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(npx wrangler deployments list:*)",
      "Bash(npx wrangler versions list:*)",
      "Bash(curl.exe -s -D - https://yemenschoolz.com/*)",
      "Bash(curl.exe -s -D - https://school.procorners.com/*)",
      "mcp__cloudflare-observability__observability_keys",
      "mcp__cloudflare-observability__observability_values",
      "mcp__cloudflare-observability__query_worker_observability",
      "mcp__cloudflare-observability__workers_get_worker",
      "mcp__cloudflare-observability__search_cloudflare_documentation",
      "mcp__plugin_cloudflare_cloudflare-api__execute",

      "Bash(npx wrangler whoami)",
      "Bash(npx wrangler tail:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote -v)",
      "Bash(git shortlog:*)",
      "Bash(git blame:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(curl.exe -s -D - https://app.yemenschoolz.com/*)",
      "Bash(curl.exe -s -D - https://school-teacher-proxy.procorners-shop.workers.dev/*)",
      "mcp__cloudflare-observability__workers_list",
      "mcp__cloudflare-observability__workers_get_worker_code",
      "mcp__plugin_cloudflare_cloudflare-builds__workers_builds_list_builds",
      "mcp__plugin_cloudflare_cloudflare-builds__workers_builds_get_build",
      "mcp__plugin_cloudflare_cloudflare-builds__workers_builds_get_build_logs",
      "mcp__plugin_cloudflare_cloudflare-api__search",
      "mcp__plugin_cloudflare_cloudflare-docs__search_cloudflare_documentation"
    ],
    "deny": [
      "Bash(npx wrangler deploy:*)",
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler delete:*)",
      "Bash(git push --force:*)"
    ]
  }
}
