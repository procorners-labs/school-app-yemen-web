# تطبيع نهايات الأسطر — إنهاء ضوضاء CRLF نهائياً (مدارس الإبداع والتميز الدولية)
# كل الملفات النصية تُخزَّن في Git بنهايات LF؛ يتكفّل Git بالتحويل عند السحب على ويندوز.
* text=auto eol=lf

# ملفات الكود (خلفية GAS + واجهة) → LF صراحةً
*.js   text eol=lf
*.gs   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.webmanifest text eol=lf

# سكربتات PowerShell على ويندوز تبقى CRLF
*.ps1  text eol=crlf

# ملفات ثنائية — لا تطبيع
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.gif  binary
*.zip  binary
